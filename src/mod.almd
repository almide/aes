import bytes

// AES-128-CFB8 encryption.
//
// Usage:
//   import aes
//   let state = aes.new_cfb8(key, iv)
//   let result = aes.cfb8_encrypt(state, plaintext)
//   let decrypted = aes.cfb8_decrypt(result.state, ciphertext)

// --- S-Box ---

let SBOX = bytes.from_list([
  0x63, 0x7C, 0x77, 0x7B, 0xF2, 0x6B, 0x6F, 0xC5, 0x30, 0x01, 0x67, 0x2B, 0xFE, 0xD7, 0xAB, 0x76,
  0xCA, 0x82, 0xC9, 0x7D, 0xFA, 0x59, 0x47, 0xF0, 0xAD, 0xD4, 0xA2, 0xAF, 0x9C, 0xA4, 0x72, 0xC0,
  0xB7, 0xFD, 0x93, 0x26, 0x36, 0x3F, 0xF7, 0xCC, 0x34, 0xA5, 0xE5, 0xF1, 0x71, 0xD8, 0x31, 0x15,
  0x04, 0xC7, 0x23, 0xC3, 0x18, 0x96, 0x05, 0x9A, 0x07, 0x12, 0x80, 0xE2, 0xEB, 0x27, 0xB2, 0x75,
  0x09, 0x83, 0x2C, 0x1A, 0x1B, 0x6E, 0x5A, 0xA0, 0x52, 0x3B, 0xD6, 0xB3, 0x29, 0xE3, 0x2F, 0x84,
  0x53, 0xD1, 0x00, 0xED, 0x20, 0xFC, 0xB1, 0x5B, 0x6A, 0xCB, 0xBE, 0x39, 0x4A, 0x4C, 0x58, 0xCF,
  0xD0, 0xEF, 0xAA, 0xFB, 0x43, 0x4D, 0x33, 0x85, 0x45, 0xF9, 0x02, 0x7F, 0x50, 0x3C, 0x9F, 0xA8,
  0x51, 0xA3, 0x40, 0x8F, 0x92, 0x9D, 0x38, 0xF5, 0xBC, 0xB6, 0xDA, 0x21, 0x10, 0xFF, 0xF3, 0xD2,
  0xCD, 0x0C, 0x13, 0xEC, 0x5F, 0x97, 0x44, 0x17, 0xC4, 0xA7, 0x7E, 0x3D, 0x64, 0x5D, 0x19, 0x73,
  0x60, 0x81, 0x4F, 0xDC, 0x22, 0x2A, 0x90, 0x88, 0x46, 0xEE, 0xB8, 0x14, 0xDE, 0x5E, 0x0B, 0xDB,
  0xE0, 0x32, 0x3A, 0x0A, 0x49, 0x06, 0x24, 0x5C, 0xC2, 0xD3, 0xAC, 0x62, 0x91, 0x95, 0xE4, 0x79,
  0xE7, 0xC8, 0x37, 0x6D, 0x8D, 0xD5, 0x4E, 0xA9, 0x6C, 0x56, 0xF4, 0xEA, 0x65, 0x7A, 0xAE, 0x08,
  0xBA, 0x78, 0x25, 0x2E, 0x1C, 0xA6, 0xB4, 0xC6, 0xE8, 0xDD, 0x74, 0x1F, 0x4B, 0xBD, 0x8B, 0x8A,
  0x70, 0x3E, 0xB5, 0x66, 0x48, 0x03, 0xF6, 0x0E, 0x61, 0x35, 0x57, 0xB9, 0x86, 0xC1, 0x1D, 0x9E,
  0xE1, 0xF8, 0x98, 0x11, 0x69, 0xD9, 0x8E, 0x94, 0x9B, 0x1E, 0x87, 0xE9, 0xCE, 0x55, 0x28, 0xDF,
  0x8C, 0xA1, 0x89, 0x0D, 0xBF, 0xE6, 0x42, 0x68, 0x41, 0x99, 0x2D, 0x0F, 0xB0, 0x54, 0xBB, 0x16,
])

let RCON = bytes.from_list([0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36])

// --- GF(2^8) ---

local fn xtime(a: Int) -> Int = {
  let shifted = int.band(int.bshl(a, 1), 0xFF)
  if int.band(a, 0x80) != 0 then int.bxor(shifted, 0x1B) else shifted
}

local fn gmul(a: Int, b: Int) -> Int = {
  var result = 0
  var va = a
  var vb = b
  var i = 0
  while i < 8 {
    if int.band(vb, 1) != 0 then { result = int.bxor(result, va) } else { () }
    va = xtime(va)
    vb = int.bshr(vb, 1)
    i = i + 1
  }
  int.band(result, 0xFF)
}

// --- Key Expansion (AES-128: 16 bytes → 176 bytes) ---

fn expand_key(key: Bytes) -> Bytes = {
  var w = bytes.new(176)
  for i in 0..16 { w = bytes.set(w, i, bytes.read_u8(key, i)) }
  var i = 4
  while i < 44 {
    let t0 = bytes.read_u8(w, (i - 1) * 4)
    let t1 = bytes.read_u8(w, (i - 1) * 4 + 1)
    let t2 = bytes.read_u8(w, (i - 1) * 4 + 2)
    let t3 = bytes.read_u8(w, (i - 1) * 4 + 3)
    if i % 4 == 0 then {
      let rc = bytes.read_u8(RCON, i / 4 - 1)
      let s0 = int.bxor(bytes.read_u8(SBOX, t1), rc)
      let s1 = bytes.read_u8(SBOX, t2)
      let s2 = bytes.read_u8(SBOX, t3)
      let s3 = bytes.read_u8(SBOX, t0)
      w = bytes.set(w, i * 4,     int.bxor(bytes.read_u8(w, (i - 4) * 4), s0))
      w = bytes.set(w, i * 4 + 1, int.bxor(bytes.read_u8(w, (i - 4) * 4 + 1), s1))
      w = bytes.set(w, i * 4 + 2, int.bxor(bytes.read_u8(w, (i - 4) * 4 + 2), s2))
      w = bytes.set(w, i * 4 + 3, int.bxor(bytes.read_u8(w, (i - 4) * 4 + 3), s3))
    } else {
      w = bytes.set(w, i * 4,     int.bxor(bytes.read_u8(w, (i - 4) * 4), t0))
      w = bytes.set(w, i * 4 + 1, int.bxor(bytes.read_u8(w, (i - 4) * 4 + 1), t1))
      w = bytes.set(w, i * 4 + 2, int.bxor(bytes.read_u8(w, (i - 4) * 4 + 2), t2))
      w = bytes.set(w, i * 4 + 3, int.bxor(bytes.read_u8(w, (i - 4) * 4 + 3), t3))
    }
    i = i + 1
  }
  w
}

// --- AES Block Operations ---

local fn sub_bytes(state: Bytes) -> Bytes = {
  var s = state
  for i in 0..16 { s = bytes.set(s, i, bytes.read_u8(SBOX, bytes.read_u8(s, i))) }
  s
}

local fn shift_rows(state: Bytes) -> Bytes = {
  var s = bytes.slice(state, 0, 16)
  let t = bytes.read_u8(state, 1)
  s = bytes.set(s, 1, bytes.read_u8(state, 5))
  s = bytes.set(s, 5, bytes.read_u8(state, 9))
  s = bytes.set(s, 9, bytes.read_u8(state, 13))
  s = bytes.set(s, 13, t)
  let t0 = bytes.read_u8(state, 2)
  let t1 = bytes.read_u8(state, 6)
  s = bytes.set(s, 2, bytes.read_u8(state, 10))
  s = bytes.set(s, 6, bytes.read_u8(state, 14))
  s = bytes.set(s, 10, t0)
  s = bytes.set(s, 14, t1)
  let t2 = bytes.read_u8(state, 15)
  s = bytes.set(s, 15, bytes.read_u8(state, 11))
  s = bytes.set(s, 11, bytes.read_u8(state, 7))
  s = bytes.set(s, 7, bytes.read_u8(state, 3))
  s = bytes.set(s, 3, t2)
  s
}

local fn mix_columns(state: Bytes) -> Bytes = {
  var s = state
  var c = 0
  while c < 4 {
    let i = c * 4
    let s0 = bytes.read_u8(state, i)
    let s1 = bytes.read_u8(state, i + 1)
    let s2 = bytes.read_u8(state, i + 2)
    let s3 = bytes.read_u8(state, i + 3)
    s = bytes.set(s, i,     int.band(int.bxor(int.bxor(gmul(2, s0), gmul(3, s1)), int.bxor(s2, s3)), 0xFF))
    s = bytes.set(s, i + 1, int.band(int.bxor(int.bxor(s0, gmul(2, s1)), int.bxor(gmul(3, s2), s3)), 0xFF))
    s = bytes.set(s, i + 2, int.band(int.bxor(int.bxor(s0, s1), int.bxor(gmul(2, s2), gmul(3, s3))), 0xFF))
    s = bytes.set(s, i + 3, int.band(int.bxor(int.bxor(gmul(3, s0), s1), int.bxor(s2, gmul(2, s3))), 0xFF))
    c = c + 1
  }
  s
}

local fn add_round_key(state: Bytes, ek: Bytes, round: Int) -> Bytes = {
  var s = state
  let off = round * 16
  for i in 0..16 { s = bytes.set(s, i, int.bxor(bytes.read_u8(s, i), bytes.read_u8(ek, off + i))) }
  s
}

// --- AES-128 Encrypt Block (16 bytes) ---

fn encrypt_block(block: Bytes, expanded_key: Bytes) -> Bytes = {
  var state = add_round_key(block, expanded_key, 0)
  for round in 1..10 {
    state = sub_bytes(state)
    state = shift_rows(state)
    state = mix_columns(state)
    state = add_round_key(state, expanded_key, round)
  }
  state = sub_bytes(state)
  state = shift_rows(state)
  add_round_key(state, expanded_key, 10)
}

// --- CFB8 Mode ---

type Cfb8State = {
  expanded_key: Bytes,
  iv: Bytes,
}

fn new_cfb8(key: Bytes, iv: Bytes) -> Cfb8State =
  { expanded_key: expand_key(key), iv: bytes.slice(iv, 0, 16) }

fn cfb8_encrypt(state: Cfb8State, plaintext: Bytes) -> { data: Bytes, state: Cfb8State } = {
  let len = bytes.len(plaintext)
  var out = bytes.new(len)
  var iv = state.iv
  for i in 0..len {
    let encrypted = encrypt_block(iv, state.expanded_key)
    let cipher_byte = int.bxor(bytes.read_u8(plaintext, i), bytes.read_u8(encrypted, 0))
    out = bytes.set(out, i, cipher_byte)
    iv = bytes.concat(bytes.slice(iv, 1, 16), bytes.from_list([cipher_byte]))
  }
  { data: out, state: { expanded_key: state.expanded_key, iv: iv } }
}

fn cfb8_decrypt(state: Cfb8State, ciphertext: Bytes) -> { data: Bytes, state: Cfb8State } = {
  let len = bytes.len(ciphertext)
  var out = bytes.new(len)
  var iv = state.iv
  for i in 0..len {
    let encrypted = encrypt_block(iv, state.expanded_key)
    let cipher_byte = bytes.read_u8(ciphertext, i)
    out = bytes.set(out, i, int.bxor(cipher_byte, bytes.read_u8(encrypted, 0)))
    iv = bytes.concat(bytes.slice(iv, 1, 16), bytes.from_list([cipher_byte]))
  }
  { data: out, state: { expanded_key: state.expanded_key, iv: iv } }
}

// --- Tests ---

let NIST_KEY = bytes.from_list([0x2B, 0x7E, 0x15, 0x16, 0x28, 0xAE, 0xD2, 0xA6, 0xAB, 0xF7, 0x15, 0x88, 0x09, 0xCF, 0x4F, 0x3C])
let NIST_IV = bytes.from_list([0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F])

test "NIST FIPS 197 Appendix B - block encrypt" {
  let plain = bytes.from_list([0x32, 0x43, 0xF6, 0xA8, 0x88, 0x5A, 0x30, 0x8D, 0x31, 0x31, 0x98, 0xA2, 0xE0, 0x37, 0x07, 0x34])
  let expected = bytes.from_list([0x39, 0x25, 0x84, 0x1D, 0x02, 0xDC, 0x09, 0xFB, 0xDC, 0x11, 0x85, 0x97, 0x19, 0x6A, 0x0B, 0x32])
  assert_eq(bytes.to_list(encrypt_block(plain, expand_key(NIST_KEY))), bytes.to_list(expected))
}

test "NIST SP 800-38A F.1.1 ECB vector 1" {
  let plain = bytes.from_list([0x6B, 0xC1, 0xBE, 0xE2, 0x2E, 0x40, 0x9F, 0x96, 0xE9, 0x3D, 0x7E, 0x11, 0x73, 0x93, 0x17, 0x2A])
  let expected = bytes.from_list([0x3A, 0xD7, 0x7B, 0xB4, 0x0D, 0x7A, 0x36, 0x60, 0xA8, 0x9E, 0xCA, 0xF3, 0x24, 0x66, 0xEF, 0x97])
  assert_eq(bytes.to_list(encrypt_block(plain, expand_key(NIST_KEY))), bytes.to_list(expected))
}

test "NIST SP 800-38A F.1.1 ECB vector 2" {
  let plain = bytes.from_list([0xAE, 0x2D, 0x8A, 0x57, 0x1E, 0x03, 0xAC, 0x9C, 0x9E, 0xB7, 0x6F, 0xAC, 0x45, 0xAF, 0x8E, 0x51])
  let expected = bytes.from_list([0xF5, 0xD3, 0xD5, 0x85, 0x03, 0xB9, 0x69, 0x9D, 0xE7, 0x85, 0x89, 0x5A, 0x96, 0xFD, 0xBA, 0xAF])
  assert_eq(bytes.to_list(encrypt_block(plain, expand_key(NIST_KEY))), bytes.to_list(expected))
}

test "block encrypt - all zeros" {
  let key = bytes.new(16)
  let plain = bytes.new(16)
  let expected = bytes.from_list([0x66, 0xE9, 0x4B, 0xD4, 0xEF, 0x8A, 0x2C, 0x3B, 0x88, 0x4C, 0xFA, 0x59, 0xCA, 0x34, 0x2B, 0x2E])
  assert_eq(bytes.to_list(encrypt_block(plain, expand_key(key))), bytes.to_list(expected))
}

test "key expansion - round key 1" {
  let ek = expand_key(NIST_KEY)
  let rk1 = bytes.slice(ek, 16, 32)
  let expected = bytes.from_list([0xA0, 0xFA, 0xFE, 0x17, 0x88, 0x54, 0x2C, 0xB1, 0x23, 0xA3, 0x39, 0x39, 0x2A, 0x6C, 0x76, 0x05])
  assert_eq(bytes.to_list(rk1), bytes.to_list(expected))
}

test "key expansion - round key 10" {
  let ek = expand_key(NIST_KEY)
  let rk10 = bytes.slice(ek, 160, 176)
  let expected = bytes.from_list([0xD0, 0x14, 0xF9, 0xA8, 0xC9, 0xEE, 0x25, 0x89, 0xE1, 0x3F, 0x0C, 0xC8, 0xB6, 0x63, 0x0C, 0xA6])
  assert_eq(bytes.to_list(rk10), bytes.to_list(expected))
}

test "CFB8 - NIST SP 800-38A F.3.7 encrypt 4 bytes" {
  let plain = bytes.from_list([0x6B, 0xC1, 0xBE, 0xE2])
  let expected = bytes.from_list([0x3B, 0x79, 0x42, 0x4C])
  assert_eq(bytes.to_list(cfb8_encrypt(new_cfb8(NIST_KEY, NIST_IV), plain).data), bytes.to_list(expected))
}

test "CFB8 - NIST SP 800-38A F.3.7 full 18 bytes" {
  let plain = bytes.from_list([0x6B, 0xC1, 0xBE, 0xE2, 0x2E, 0x40, 0x9F, 0x96, 0xE9, 0x3D, 0x7E, 0x11, 0x73, 0x93, 0x17, 0x2A, 0xAE, 0x2D])
  let expected = bytes.from_list([0x3B, 0x79, 0x42, 0x4C, 0x9C, 0x0D, 0xD4, 0x36, 0xBA, 0xCE, 0x9E, 0x0E, 0xD4, 0x58, 0x6A, 0x4F, 0x32, 0xB9])
  assert_eq(bytes.to_list(cfb8_encrypt(new_cfb8(NIST_KEY, NIST_IV), plain).data), bytes.to_list(expected))
}

test "CFB8 - NIST SP 800-38A F.3.8 decrypt 18 bytes" {
  let cipher = bytes.from_list([0x3B, 0x79, 0x42, 0x4C, 0x9C, 0x0D, 0xD4, 0x36, 0xBA, 0xCE, 0x9E, 0x0E, 0xD4, 0x58, 0x6A, 0x4F, 0x32, 0xB9])
  let expected = bytes.from_list([0x6B, 0xC1, 0xBE, 0xE2, 0x2E, 0x40, 0x9F, 0x96, 0xE9, 0x3D, 0x7E, 0x11, 0x73, 0x93, 0x17, 0x2A, 0xAE, 0x2D])
  assert_eq(bytes.to_list(cfb8_decrypt(new_cfb8(NIST_KEY, NIST_IV), cipher).data), bytes.to_list(expected))
}

test "CFB8 roundtrip" {
  let plain = bytes.from_string("Hello Minecraft!")
  let enc = cfb8_encrypt(new_cfb8(NIST_KEY, NIST_IV), plain)
  let dec = cfb8_decrypt(new_cfb8(NIST_KEY, NIST_IV), enc.data)
  assert_eq(bytes.to_list(dec.data), bytes.to_list(plain))
}

test "CFB8 roundtrip - single byte" {
  let key = bytes.from_list([0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x10])
  let iv = bytes.from_list([0xFF, 0xFE, 0xFD, 0xFC, 0xFB, 0xFA, 0xF9, 0xF8, 0xF7, 0xF6, 0xF5, 0xF4, 0xF3, 0xF2, 0xF1, 0xF0])
  let enc = cfb8_encrypt(new_cfb8(key, iv), bytes.from_list([0x42]))
  let dec = cfb8_decrypt(new_cfb8(key, iv), enc.data)
  assert_eq(bytes.to_list(dec.data), [0x42])
}

test "CFB8 roundtrip - empty" {
  let enc = cfb8_encrypt(new_cfb8(NIST_KEY, NIST_IV), bytes.new(0))
  assert_eq(bytes.len(enc.data), 0)
}

test "CFB8 streaming - chunks match single" {
  let data = bytes.from_string("Hello World 1234")
  let full = cfb8_encrypt(new_cfb8(NIST_KEY, NIST_IV), data)
  let s0 = new_cfb8(NIST_KEY, NIST_IV)
  let r1 = cfb8_encrypt(s0, bytes.slice(data, 0, 5))
  let r2 = cfb8_encrypt(r1.state, bytes.slice(data, 5, 10))
  let r3 = cfb8_encrypt(r2.state, bytes.slice(data, 10, 16))
  let chunked = bytes.concat(bytes.concat(r1.data, r2.data), r3.data)
  assert_eq(bytes.to_list(full.data), bytes.to_list(chunked))
}

test "CFB8 - ciphertext differs from plaintext" {
  let plain = bytes.from_string("AAAAAAAAAAAAAAAA")
  let enc = cfb8_encrypt(new_cfb8(NIST_KEY, NIST_IV), plain)
  assert_ne(bytes.to_list(enc.data), bytes.to_list(plain))
}

test "CFB8 - different keys produce different output" {
  let plain = bytes.from_string("test data")
  let key1 = bytes.new(16)
  var key2 = bytes.new(16)
  key2 = bytes.set(key2, 15, 1)
  let e1 = cfb8_encrypt(new_cfb8(key1, NIST_IV), plain)
  let e2 = cfb8_encrypt(new_cfb8(key2, NIST_IV), plain)
  assert_ne(bytes.to_list(e1.data), bytes.to_list(e2.data))
}

test "CFB8 - different IVs produce different output" {
  let plain = bytes.from_string("test data")
  let iv1 = bytes.new(16)
  var iv2 = bytes.new(16)
  iv2 = bytes.set(iv2, 15, 1)
  let e1 = cfb8_encrypt(new_cfb8(NIST_KEY, iv1), plain)
  let e2 = cfb8_encrypt(new_cfb8(NIST_KEY, iv2), plain)
  assert_ne(bytes.to_list(e1.data), bytes.to_list(e2.data))
}
